// ============================================================================
// Beta Diversity Pipeline — Nextflow Configuration
// ============================================================================

params {
    // ---- Input / Output ----------------------------------------------------
    feature_table        = "${projectDir}/data/feature_table.biom"
    meta_table           = "${projectDir}/data/meta_table.csv"
    taxonomy_table       = ""
    tree_file            = ""
    input_format         = "biom"
    output_dir           = "${projectDir}/results"
    scripts_dir          = "/opt/ecology-scripts"

    // ---- Filtering ---------------------------------------------------------
    min_library_size     = 5000
    exclude_column       = ""
    exclude_values       = ""

    // ---- Grouping ----------------------------------------------------------
    groups_column          = ""
    groups_paste_columns   = ""
    type_column            = ""
    type2_column           = ""
    connections_column     = ""
    subconnections_column  = ""

    // ---- Ordination --------------------------------------------------------
    which_level          = "Otus"
    label                = "analysis"
    distance_metric      = "bray"          // comma-separated list for parallel runs, e.g. "bray,jaccard,wunifrac"
    ordination_method    = "pcoa"
    ellipse_kind         = "se"

    // ---- PERMANOVA ---------------------------------------------------------
    permanova_variables    = ""
    permanova_permutations = 999
    p_adjust_method        = "BH"

    // ---- Output ------------------------------------------------------------
    merge_parquet          = false         // merge all output CSVs into one Parquet file
}

docker {
    enabled    = true
    runOptions = '-u $(id -u):$(id -g)'
}

process {
    container = 'reubenduncan/ecologyflow-beta:latest'

    withName: 'MERGE_PARQUET' {
        cpus   = 1
        memory = '4 GB'
        time   = '15 min'
    }
}
