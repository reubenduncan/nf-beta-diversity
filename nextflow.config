// ============================================================================
// Beta Diversity Pipeline — Nextflow Configuration
// ============================================================================

params {
    // ---- Input / Output ----------------------------------------------------
    feature_table        = "${projectDir}/data/feature_table.biom"
    meta_table           = "${projectDir}/data/meta_table.csv"
    taxonomy_table       = ""
    tree_file            = ""
    input_format         = "biom"
    output_dir           = "${projectDir}/results"

    // ---- Filtering ---------------------------------------------------------
    min_library_size     = 5000
    exclude_column       = ""
    exclude_values       = ""

    // ---- Grouping ----------------------------------------------------------
    groups_column          = ""
    groups_paste_columns   = ""
    type_column            = ""
    type2_column           = ""
    connections_column     = ""
    subconnections_column  = ""

    // ---- Ordination --------------------------------------------------------
    taxon_rank          = "Feature"
    label                = "analysis"
    distance_metric      = "bray"          // comma-separated list for parallel runs, e.g. "bray,jaccard,wunifrac"
    ordination_method    = "pcoa"
    ellipse_kind         = "se"

    // ---- PERMANOVA ---------------------------------------------------------
    permanova_variables    = ""
    permanova_permutations = 999
    p_adjust_method        = "BH"

    // ---- Output ------------------------------------------------------------
    merge_parquet          = false         // merge all output CSVs into one Parquet file
}

// ---- Default: conda --------------------------------------------------------
conda.enabled  = true
docker.enabled = false

process {
    conda = "${projectDir}/environment.yml"

    withName: 'MERGE_PARQUET' {
        cpus   = 1
        memory = '4 GB'
        time   = '15 min'
    }
}

profiles {
    conda {
        conda.enabled  = true
        docker.enabled = false
    }
    docker {
        conda.enabled     = false
        docker.enabled    = true
        docker.runOptions = "-u \$(id -u):\$(id -g) -v ${projectDir}:${projectDir}:ro"
        process {
            container = 'reubenduncan/ecologyflow-beta:latest'
        }
    }
    singularity {
        conda.enabled          = false
        singularity.enabled    = true
        singularity.autoMounts = true
        process {
            container = 'docker://reubenduncan/ecologyflow-beta:latest'
        }
    }
}
